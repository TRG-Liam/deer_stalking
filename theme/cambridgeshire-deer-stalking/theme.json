{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": true,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "color": "#ECE4D9", "name": "Parchment", "slug": "parchment" },
				{ "color": "#F3EDE5", "name": "Parchment soft", "slug": "parchment-soft" },
				{ "color": "#E7E9E6", "name": "Sage", "slug": "sage" },
				{ "color": "#192620", "name": "Green black", "slug": "green-black" },
				{ "color": "#104520", "name": "Hunting green", "slug": "hunting-green" },
				{ "color": "#3B423F", "name": "Charcoal", "slug": "charcoal" },
				{ "color": "#6E736F", "name": "Charcoal muted", "slug": "charcoal-muted" },
				{ "color": "#A98B5F", "name": "Brass", "slug": "brass" },
				{ "color": "#7B2631", "name": "Oxblood", "slug": "oxblood" },
				{ "color": "#631E27", "name": "Oxblood deep", "slug": "oxblood-deep" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "16", "size": "16px", "slug": "30" },
				{ "name": "24", "size": "24px", "slug": "40" },
				{ "name": "32", "size": "32px", "slug": "50" },
				{ "name": "48", "size": "48px", "slug": "60" },
				{ "name": "64", "size": "64px", "slug": "70" },
				{ "name": "96", "size": "96px", "slug": "80" },
				{ "name": "128", "size": "128px", "slug": "90" },
				{ "name": "160", "size": "160px", "slug": "100" }
			],
			"units": [ "px", "rem", "vh" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [ "file:./assets/fonts/cormorant-garamond-500.woff2" ]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [ "file:./assets/fonts/cormorant-garamond-600.woff2" ]
						}
					],
					"fontFamily": "\"Cormorant Garamond\", Georgia, serif",
					"name": "Cormorant Garamond",
					"slug": "serif"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [ "file:./assets/fonts/inter-400.woff2" ]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [ "file:./assets/fonts/inter-500.woff2" ]
						}
					],
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif",
					"name": "Inter",
					"slug": "sans"
				}
			],
			"fontSizes": [
				{ "name": "Caption", "size": "13px", "slug": "caption" },
				{ "name": "Small", "size": "15px", "slug": "small" },
				{ "name": "Body", "size": "17px", "slug": "body" },
				{ "name": "Lead", "size": "19px", "slug": "lead" },
				{ "name": "Heading 4", "size": "21px", "slug": "h4" },
				{ "name": "Heading 3", "size": "26px", "slug": "h3" },
				{ "name": "Heading 2", "size": "clamp(30px,3.1vw,40px)", "slug": "h2" },
				{ "name": "Heading 1", "size": "clamp(38px,4.4vw,56px)", "slug": "h1" },
				{ "name": "Display", "size": "clamp(48px,6.2vw,80px)", "slug": "display" }
			]
		}
	},
	"styles": {
		"blocks": {
			"core/pullquote": {
				"border": {
					"top": { "color": "var:preset|color|brass", "style": "solid", "width": "1px" },
					"right": { "width": "0" },
					"bottom": { "color": "var:preset|color|brass", "style": "solid", "width": "1px" },
					"left": { "width": "0" }
				},
				"color": {
					"text": "var:preset|color|green-black"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|serif",
					"fontSize": "var(--wp--preset--font-size--h-3)",
					"fontStyle": "normal",
					"fontWeight": "500"
				}
			},
			"core/separator": {
				"border": {
					"color": "var:preset|color|brass",
					"style": "solid",
					"width": "0 0 1px 0"
				},
				"color": {
					"text": "var:preset|color|brass"
				}
			}
		},
		"color": {
			"background": "var:preset|color|parchment",
			"text": "var:preset|color|charcoal"
		},
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var:preset|color|oxblood-deep",
						"text": "var:preset|color|parchment-soft"
					}
				},
				"border": {
					"radius": "2px"
				},
				"color": {
					"background": "var:preset|color|oxblood",
					"text": "var:preset|color|parchment-soft"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontWeight": "500"
				}
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--h-1)" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--h-2)" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--h-3)" }
			},
			"h4": {
				"typography": { "fontSize": "var(--wp--preset--font-size--h-4)" }
			},
			"heading": {
				"color": {
					"text": "var:preset|color|green-black"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|serif",
					"fontStyle": "normal",
					"fontWeight": "500",
					"lineHeight": "1.14"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|hunting-green"
				},
				"typography": {
					"textDecoration": "underline"
				}
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|body",
			"lineHeight": "1.68"
		}
	},
	"templateParts": [
		{ "area": "header", "name": "header", "title": "Header" },
		{ "area": "footer", "name": "footer", "title": "Footer" }
	]
}
